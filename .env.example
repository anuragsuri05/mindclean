# Copy to .env.local and fill in what you need. Everything is optional for local demo mode.

# Public URL of the app (used to build OAuth redirect URLs).
APP_URL=http://localhost:3000

# 32+ random characters. Encrypts stored platform tokens. Auto-generated into .data/ if unset (dev only).
APP_SECRET=

# AI features run on each user's own ChatGPT plan via "Sign in with ChatGPT".
# No key needed. Works out of the box when Mindclean runs locally (http://127.0.0.1 or localhost).
# Hosted deployments need OpenAI's approval (waitlist); once approved, set the registered callback here:
CHATGPT_REDIRECT_URI=

# Optional server-side fallback for users who haven't connected ChatGPT.
# Without either, Mindclean falls back to keyword heuristics.
ANTHROPIC_API_KEY=

# Reddit (live home feed). Create a "web app" at https://www.reddit.com/prefs/apps
# Redirect URI: {APP_URL}/api/oauth/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube (live subscriptions feed). Google Cloud console -> OAuth client (Web), enable "YouTube Data API v3".
# Redirect URI: {APP_URL}/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
